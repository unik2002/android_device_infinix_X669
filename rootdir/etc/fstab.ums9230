# fstab.ums9230 - Infinix HOT 30i (X669) - Unisoc UMS9230
# Generated from stock fstab + recovery.fstab (encryption flags)

# --------------------------
# Logical / Dynamic partitions
# --------------------------

# system — dual entry (erofs primary, ext4 fallback)
system  /system  erofs  ro  wait,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey,slotselect
system  /system  ext4   ro,barrier=1  wait,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey,slotselect

# system_ext
system_ext  /system_ext  erofs  ro  wait,avb=vbmeta_system_ext,logical,first_stage_mount,slotselect

# vendor
vendor  /vendor  erofs  ro  wait,avb=vbmeta_vendor,logical,first_stage_mount,slotselect

# product
product  /product  erofs  ro  wait,avb=vbmeta_product,logical,first_stage_mount,slotselect

# vendor_dlkm
vendor_dlkm  /vendor_dlkm  ext4  noatime,ro,errors=panic  wait,avb=vbmeta_vendor,logical,first_stage_mount,slotselect

# --------------------------
# Physical partitions
# --------------------------

# metadata (must mount before userdata for FBE key storage)
/dev/block/by-name/metadata  /metadata  ext4  nodev,noatime,nosuid,errors=panic  wait,formattable,first_stage_mount,check

# userdata — f2fs with FBE inline encryption (from recovery.fstab — newer flags)
/dev/block/by-name/userdata  /data  f2fs  noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,inline_xattr,inline_data,inlinecrypt,fsync_mode=nobarrier,compress_cache,compress_algorithm=lz4,compress_log_size=2,compress_extension=apk,compress_extension=so,compress_mode=fs  latemount,wait,quota,check,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,reservedsize=128M,checkpoint=fs,formattable,fscompress

# persist
/dev/block/by-name/persist  /persist  emmc  defaults  defaults

# misc
/dev/block/by-name/misc  /misc  emmc  defaults  defaults

# prodnv
/dev/block/by-name/prodnv  /mnt/vendor  ext4  noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc  wait,check

# cache
/dev/block/by-name/cache  /cache  ext4  noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc  wait,check

# tranfs (Transsion/Infinix OEM partition)
/dev/block/by-name/tranfs  /tranfs  ext4  rw,noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc  wait,check,formattable,nofail

# --------------------------
# Removable storage
# --------------------------

# USB OTG
/devices/platform/soc/soc:aon/64900000.usb/musb-hdrc.*.auto/usb*  auto  vfat  defaults  voldmanaged=usbdisk:auto

# SD card
/devices/platform/soc/soc:ap-apb/201a0000.sdio/mmc_host/mmc1/mmc1:*/block/mmcblk1  auto  vfat  defaults  voldmanaged=sdcard0:auto,noemulatedsd,encryptable=footer
